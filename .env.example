# Copy this file to .env and replace the placeholders with your own values.
# Never commit .env or paste API keys into source code.

# Copy to .env and add your own API key.
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=your_supported_groq_model_idb

# Alternative: Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=your_groq_model_id

# Alternative: OpenAI (comment out LLM_BASE_URL to use the default endpoint)
# LLM_MODEL=gpt-4o-mini

# Alternative: local Ollama OpenAI-compatible endpoint
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
